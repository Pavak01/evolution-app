# Points at the SAME database as Qbit (shared `users` table for
# no-re-registration auth continuity). Evolution's own tables live in the
# `evolution` schema — see db.ts / sql/schema.sql — so this is safe to point
# at Qbit's real database without colliding with its existing tables.
PORT=4000
DATABASE_URL=postgres://user:pass@localhost:5432/evolution
# Deliberately a DIFFERENT secret than Qbit's — sessions don't carry over
# (existing users just log in once), keeping the two apps' auth independent.
JWT_SECRET=change-me-in-production
# Must match Qbit's TWO_FACTOR_ENCRYPTION_KEY exactly — this decrypts the
# same encrypted TOTP secret Qbit already stored on shared user accounts.
TWO_FACTOR_ENCRYPTION_KEY=
ALLOWED_ORIGINS=
AWS_S3_BUCKET_NAME=
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
RECEIPTS_S3_FORCE_PATH_STYLE=false
# Powers the OCR auto-fill paid upgrade (backend/src/receiptExtraction.ts).
# Extraction degrades gracefully to empty fields if this is unset — never
# blocks the manual-entry fallback — but the feature won't do anything
# useful without it.
ANTHROPIC_API_KEY=
