{
  "expo": {
    "name": "Evolution",
    "slug": "evolution-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.aplc.weeklytaxapp",
      "versionCode": 102,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f5ede1"
      }
    },
    "ios": {
      "bundleIdentifier": "com.aplc.weeklytaxapp",
      "buildNumber": "1"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Evolution to access your camera so you can photograph receipts.",
          "photosPermission": "Allow Evolution to access your photos so you can attach an existing image as a receipt.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "15509214-ea42-42f2-8b3e-4d8c40cb5ac0"
      }
    },
    "owner": "pavak01"
  }
}
