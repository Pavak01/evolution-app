{
  "expo": {
    "name": "Evolution",
    "slug": "evolution-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.aplc.weeklytaxapp",
      "versionCode": 111,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#2f566f"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "ios": {
      "bundleIdentifier": "com.aplc.weeklytaxapp",
      "buildNumber": "1"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Evolution to access your camera so you can photograph receipts.",
          "photosPermission": "Allow Evolution to access your photos so you can attach an existing image as a receipt.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-notifications",
      "expo-sharing",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "QuickLog",
              "label": "Evolution \u2014 quick log",
              "description": "Snap a receipt or record income in one tap",
              "minWidth": "250dp",
              "minHeight": "40dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 0
            }
          ]
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "image/*",
            "application/pdf",
            "text/csv",
            "text/comma-separated-values"
          ],
          "disableIOS": true
        }
      ],
      "expo-quick-actions",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#f5ede1"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "15509214-ea42-42f2-8b3e-4d8c40cb5ac0"
      }
    },
    "owner": "pavak01",
    "scheme": "evolution"
  }
}
