# Base URL the app calls for the backend API.
# For a physical device via Expo Go, this must be reachable from the phone —
# "localhost" resolves to the phone itself, not this machine, so it won't work.
# Point at the deployed backend (default here) or your machine's LAN IP for
# a locally-running backend, e.g. http://192.168.0.12:4000
EXPO_PUBLIC_API_BASE_URL=https://evolution-backend-production.up.railway.app
